#!/bin/sh
set -eu
cd "$(dirname "$0")/.."

command_name=${1:-help}
if [ "$#" -gt 0 ]; then
    shift
fi

case "$command_name" in
    help|-h|--help)
        if [ "$#" -gt 0 ]; then
            exec ./scripts/cargo run --quiet --locked -p tessel-editor-core --bin tessel-headless -- help "$@"
        fi
        cat <<'USAGE'
Usage: ./scripts/tessel <command>

  help [topic]      Read a guide for splat, camera or preview
  editor            Open the desktop editor
  ui <command>      Control a running editor window
  headless          Edit a project with JSON Lines on stdin
  media             Run media operations with JSON Lines on stdin
  render            Render frames or export video with JSON Lines on stdin

USAGE
        cat docs/guides/README.md
        ;;
    editor)
        exec ./scripts/cargo run --quiet --locked -p tessel-editor -- "$@"
        ;;
    ui)
        exec ./scripts/cargo run --quiet --locked -p tessel-editor -- ui "$@"
        ;;
    headless)
        exec ./scripts/cargo run --quiet --locked -p tessel-editor-core --bin tessel-headless -- "$@"
        ;;
    media)
        exec ./scripts/cargo run --quiet --locked -p tessel-editor-media --bin tessel-media -- "$@"
        ;;
    render)
        exec ./scripts/cargo run --quiet --locked -p tessel-editor-render --bin tessel-render -- "$@"
        ;;
    *)
        printf 'Unknown command: %s. Run ./scripts/tessel help.\n' "$command_name" >&2
        exit 2
        ;;
esac

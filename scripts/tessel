#!/bin/sh
set -eu
scripts_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

command_name=${1:-help}
if [ "$#" -gt 0 ]; then
    shift
fi

case "$command_name" in
    export|setup|package|restore)
        if [ "${OS:-}" = Windows_NT ] && command -v py >/dev/null 2>&1; then
            exec py -3 -X utf8 "$scripts_dir/tessel_workflows.py" "$command_name" "$@"
        fi
        if command -v python3 >/dev/null 2>&1; then
            exec python3 -X utf8 "$scripts_dir/tessel_workflows.py" "$command_name" "$@"
        fi
        if command -v python >/dev/null 2>&1; then
            exec python -X utf8 "$scripts_dir/tessel_workflows.py" "$command_name" "$@"
        fi
        printf 'Python 3 is required for tessel %s.\n' "$command_name" >&2
        exit 127
        ;;
esac
cd "$scripts_dir/.."

case "$command_name" in
    help|-h|--help)
        if [ "$#" -gt 0 ]; then
            exec ./scripts/cargo run --quiet --locked -p tessel-editor-core --bin tessel-headless -- help "$@"
        fi
        cat <<'USAGE'
Usage: ./scripts/tessel <command>

  help [topic]      Read a guide by topic (listed below)
  editor            Open the desktop editor
  ui <command>      Control a running editor window
  headless          Edit a project with JSON Lines on stdin
  media             Run media operations with JSON Lines on stdin
  render            Render frames or export video with JSON Lines on stdin
  export            Export a project, frame range or camera preview with progress
  setup             Prepare and check the local rendering stack
  package           Pack the editable project and its media
  restore           Verify and restore a project package

USAGE
        cat docs/guides/README.md
        ;;
    editor)
        exec ./scripts/cargo run --quiet --locked -p tessel-editor -- "$@"
        ;;
    ui)
        exec ./scripts/cargo run --quiet --locked -p tessel-editor -- ui "$@"
        ;;
    headless)
        exec ./scripts/cargo run --quiet --locked -p tessel-editor-core --bin tessel-headless -- "$@"
        ;;
    media)
        exec ./scripts/cargo run --quiet --locked -p tessel-editor-media --bin tessel-media -- "$@"
        ;;
    render)
        exec ./scripts/cargo run --quiet --locked -p tessel-editor-render --bin tessel-render -- "$@"
        ;;
    *)
        printf 'Unknown command: %s. Run ./scripts/tessel help.\n' "$command_name" >&2
        exit 2
        ;;
esac

  "scope": {
    "claim": "O oráculo executa funções puras REAIS de packages/scene-engine empacotadas SEM modificação (esbuild + zod 4.3.6 + three 0.187.0, sem GPU/DOM/rede). Não é a engine completa, nem o runtime Three.js, nem o editor. Cobertura por linha NÃO foi medida: 'executed' abaixo significa chamado pelo harness (direto) ou exercitado por essas chamadas para as entradas do corpus.",
    "executedFunctions": [
      {
        "module": "src/schema/render-bundle.schema.ts",
        "symbols": [
          "renderBundleSchema.safeParse (schema zod + superRefine do bundle)"
        ],
        "how": "chamada direta",
        "mig": [
          "MIG001",
          "MIG019"
        ]
      },
      {
        "module": "src/validate/bundle-integrity.ts",
        "symbols": [
          "validateBundleIntegrity"
        ],
        "how": "direta (sobre o bundle parseado) e dentro do schema (todos os casos que chegam ao refinamento)",
        "mig": [
          "MIG002"
        ]
      },
      {
        "module": "src/validate/edit-joins.ts",
        "symbols": [
          "validateEditJoins"
        ],
        "how": "chamada direta e dentro de finalizeBundle",
        "mig": [
          "MIG002"
        ]
      },
      {
        "module": "src/edit/finalize-bundle.ts",
        "symbols": [
          "finalizeBundle"
        ],
        "how": "chamada direta: é o veredito que a CLI `scene validate` usa (schema + junções), menos a checagem de arquivos em disco",
        "mig": [
          "MIG002",
          "MIG003"
        ]
      },
      {
        "module": "src/scene/scene-graph.ts",
        "symbols": [
          "validateSceneGraphStructure",
          "resolveParentLinks",
          "computeWorldMatrices",
          "quatSchemaToEulerDegrees (via evaluateEditFrame)"
        ],
        "how": "chamada direta (estrutura também sobre o JSON cru, mesmo quando o schema recusa)",
        "mig": [
          "MIG012"
        ]
      },
      {
        "module": "src/evaluator/evaluate-edit-frame.ts",
        "symbols": [
          "evaluateEditFrame"
        ],
        "how": "chamada direta nos frames de borda",
        "mig": [
          "MIG016"
        ]
      },
      {
        "module": "src/edit/resolve-shot-at-edit-frame.ts",
        "symbols": [
          "resolveShotAtEditFrame"
        ],
        "how": "via evaluateEditFrame",
        "mig": [
          "MIG016",
          "MIG018"
        ]
      },
      {
        "module": "src/performance/resolve-performance.ts",
        "symbols": [
          "resolvePerformanceOverrides",
          "mergeTransformWithOverride"
        ],
        "how": "via evaluateEditFrame (cycle, event e static no caso valid-graph-sockets-performance)",
        "mig": [
          "MIG017"
        ]
      },
      {
        "module": "src/camera/resolve-camera-clip.ts",
        "symbols": [
          "resolveCameraAtClipFrame",
          "mainTrackPoses",
          "getCameraClipDurationFrames",
          "resolveClipFrame (via validação das camadas)"
        ],
        "how": "chamada direta nos frames de borda de cada movimento; recipes: dollyIn, truckRight, truckLeft, zoomIn, zoomOut, orbit, keyframes, hold; 2 camadas aditivas",
        "mig": [
          "MIG031",
          "MIG032"
        ]
      },
      {
        "module": "src/camera/easing.ts",
        "symbols": [
          "applyEasing: linear, easeInOutCubic, easeOutCubic"
        ],
        "how": "via resolveCameraAtClipFrame",
        "mig": [
          "MIG032"
        ]
      },
      {
        "module": "src/keyframes/resolve-keyframes.ts",
        "symbols": [
          "resolveKeyframes"
        ],
        "how": "via movimento `keyframes` da câmera",
        "mig": [
          "MIG032",
          "MIG047"
        ]
      }
    ],
    "loadedButNotExercised": [
      {
        "modules": [
          "src/narration/*",
          "src/outline/*",
          "src/rig/*",
          "src/path/*",
          "src/effects/*",
          "src/weather/*",
          "src/lighting/*"
        ],

        "module": "src/validate/edit-joins.ts",
        "symbols": [
          "validateEditJoins (via inspectBundle/finalizeBundle)",
          "JOIN_POSITION_TOLERANCE_SCENE_UNITS",
          "JOIN_FOV_TOLERANCE_DEG",
          "JOIN_VELOCITY_TOLERANCE_SCENE_UNITS_PER_FRAME",
          "JOIN_FOV_VELOCITY_TOLERANCE_DEG_PER_FRAME"
        ],
        "how": "validateEditJoins via o harness base; as quatro constantes são importadas direto do módulo real e conferidas com tolerances.json",

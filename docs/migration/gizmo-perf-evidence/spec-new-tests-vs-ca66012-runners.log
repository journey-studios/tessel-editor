#   scripts/gizmo-perf/harness.py             c45a428c37b03e15c462af1056eee3b1d45f43d5 (0224c40fcceda8250cef30415d4e35813e233421)
#   scripts/gizmo-perf/run.py                 f44d3d08fb2c0153a61a761aac39be4423cbfb47 (a8eae98ce6647bd91480f0bfa3840c934ac66471)

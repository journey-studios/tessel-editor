diff --git a/runtime/src/perf.js b/runtime/src/perf.js
new file mode 100644
index 0000000..49ce9c8
--- /dev/null
+++ b/runtime/src/perf.js
@@ -0,0 +1,47 @@
+// LOCAL MEASUREMENT PROBE (investigation, not committed). Collects per-frame spans on the page clock
+// and posts them to the host as `{"perf": ...}` lines (host appends them to TESSEL_PERF_LOG).
+const post = (obj) => {
+  try {
+    window.ipc?.postMessage(JSON.stringify(obj));
+  } catch {
+    // no host
+  }
+};
+export const DRAIN = globalThis.__TESSEL_PERF_DRAIN === true;
+let frame = null;
+export const perf = {
+  begin(id, recvAt) {
+    frame = { id, t0: performance.now(), queue_ms: recvAt ? performance.now() - recvAt : 0, layers: [], sum: {}, cnt: {} };
+  },
+  active: () => frame !== null,
+  add(name, ms) {
+    if (!frame) return;
+    frame.sum[name] = (frame.sum[name] ?? 0) + ms;
+    frame.cnt[name] = (frame.cnt[name] ?? 0) + 1;
+  },
+  set(name, value) {
+    if (frame) frame.sum[name] = value;
+  },
+  layer(info) {
+    frame?.layers.push(info);
+  },
+  end(extra) {
+    if (!frame) return;
+    const f = frame;
+    frame = null;
+    f.total_ms = performance.now() - f.t0;
+    post({ perf: 'frame', ...f, ...extra });
+  },
+  drop() {
+    frame = null;
+  },
+  post,
+};
+export const timed = async (name, fn) => {
+  const t = performance.now();
+  try {
+    return await fn();
+  } finally {
+    perf.add(name, performance.now() - t);
+  }
+};

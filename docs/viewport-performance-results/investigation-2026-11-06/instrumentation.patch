new file mode 100644
index 0000000..035acd1
--- /dev/null
+++ b/crates/desktop/src/perf_probe.rs
@@ -0,0 +1,50 @@
+//! LOCAL MEASUREMENT PROBE (investigation, not committed): appends JSON lines to the file named by
+//! `TESSEL_PERF_LOG`. Off (one `OnceLock` read) when the variable is unset.
+use std::io::Write;
+use std::sync::{Mutex, OnceLock};
+use std::time::Instant;
+
+struct Sink {
+    file: Mutex<std::io::BufWriter<std::fs::File>>,
+    epoch: Instant,
+}
+
+fn sink() -> Option<&'static Sink> {
+    static SINK: OnceLock<Option<Sink>> = OnceLock::new();
+    SINK.get_or_init(|| {
+        let path = std::env::var_os("TESSEL_PERF_LOG")?;
+        let file = std::fs::OpenOptions::new().create(true).append(true).open(path).ok()?;
+        Some(Sink { file: Mutex::new(std::io::BufWriter::new(file)), epoch: Instant::now() })
+    })
+    .as_ref()
+}
+
+pub fn enabled() -> bool {
+    sink().is_some()
+}
+
+pub fn now_ms() -> f64 {
+    sink().map_or(0.0, |s| s.epoch.elapsed().as_secs_f64() * 1000.0)
+}
+
+/// `kind` plus a pre-formatted JSON object body (without braces).
+pub fn log(kind: &str, body: &str) {
+    if let Some(s) = sink() {
+        let t = s.epoch.elapsed().as_secs_f64() * 1000.0;
+        if let Ok(mut f) = s.file.lock() {
+            let _ = writeln!(f, "{{\"k\":\"{kind}\",\"t\":{t:.3},{body}}}");
+            let _ = f.flush();
+        }
+    }
+}
+
+/// A raw JSON line sent by the page (`perf.log`), stamped with the host clock on arrival.
+pub fn page_line(raw: &str) {
+    if let Some(s) = sink() {
+        let t = s.epoch.elapsed().as_secs_f64() * 1000.0;
+        if let Ok(mut f) = s.file.lock() {
+            let _ = writeln!(f, "{{\"k\":\"page\",\"t\":{t:.3},\"msg\":{raw}}}");
+            let _ = f.flush();
+        }
+    }
+}
